rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Public content is read-only to ordinary clients. Admin claims must be set
    // by a trusted Admin SDK environment, never by a client profile field.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        // Notification records are server-created; clients may only mark read.
        allow create, delete: if false;
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      }

      match /pushTokens/{tokenId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform == 'web';
        allow delete: if isSelf(uid);
      }

      // Per-user private app data. Keep LMS records out of this namespace.
      match /private/{document=**} {
        allow read, write: if isSelf(uid);
      }
    }

    // All unspecified collections are denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
