        </div>

        <div class="aiou-box aiou-b2">
          <div class="aiou-leg">یہ حصہ ٹیوٹر پُر کریں گے</div>
          <div class="aiou-r1">
            <div class="aiou-f"><span class="aiou-l">نام مطالعاتی مرکز</span><span class="aiou-v"></span></div>
            <div class="aiou-f"><span class="aiou-l">ضلع</span><span class="aiou-v"></span></div>
          </div>
          <div class="aiou-f aiou-r2"><span class="aiou-l">مشق وصول کرنے کی تاریخ</span><span class="aiou-v"></span></div>

          <div class="aiou-mt">
            <div class="u">سوال نمبر</div><div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div><div>7</div><div>8</div><div>9</div><div>10</div><div>11</div><div>12</div>
            <div class="u">حاصل<br>کردہ نمبر</div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
          </div>

          <div class="aiou-sb">
            <div class="lb r1">حاصل<br>کردہ نمبر</div><div class="r1"></div>
            <div class="lb">کل نمبر</div><div></div>
          </div>

          <div class="aiou-rm">
            <div class="row"><span class="l2">ٹیوٹر کی رائے</span><span class="ln" style="border:0;border-bottom:0"></span></div>
            <div class="row"></div>
            <div class="row"></div>
            <div class="row nl"><span class="l2">دستخط</span><span class="ln" style="flex:0 0 238px"></span><span class="gap"></span><span class="l2">تاریخ واپسی</span><span class="ln"></span></div>
          </div>
        </div>

        <div class="aiou-foot">نوٹ: اس فارم کی فوٹو کاپی بھی استعمال ہو سکتی ہے۔</div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
//<![CDATA[
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  var W = 794, H = 1123;

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function addr(s) {
    return esc(s.toUpperCase()).replace(/(\d)(ST|ND|RD|TH)\b/g, '$1<sup>$2</sup>');
  }
  function fmtDate(v) {
    if (!v) { return ''; }
    var p = v.split('-');
    return MONTHS[parseInt(p[1], 10) - 1] + ' ' + parseInt(p[2], 10) + ', ' + p[0];
  }
  function up(id) { return $(id).value.trim().toUpperCase(); }

  function update() {
    $('o-tname').textContent = up('i-tname');
    $('o-tadd').innerHTML = addr($('i-tadd').value.trim());
    var tp = $('i-tphone').value.trim(), sp = $('i-sphone').value.trim();
    $('o-tphone').textContent = tp ? '(' + tp + ')' : '';
    $('o-sphone').textContent = sp ? '(' + sp + ')' : '';
    $('o-sname').textContent = up('i-sname');
    $('o-sadd').innerHTML = addr($('i-sadd').value.trim());
    $('o-course').textContent = up('i-course');
    $('o-code').textContent = up('i-code');
    $('o-due').textContent = fmtDate($('i-due').value);
    $('o-disp').textContent = fmtDate($('i-disp').value);

    var year = $('i-year').value.trim();
    var isSpring = $('i-sem').value === 'spring';
    $('o-spring').textContent = isSpring ? year + ' SPRING' : '20';
    $('o-autumn').textContent = isSpring ? '20' : year + ' AUTUMN';

    var id = $('i-sid').value.replace(/\D/g, '');
    if (id.length > 0) { while (id.length !== 10) { if (id.length > 10) { id = id.substring(0, 10); } else { id = '0' + id; } } }
    var box = $('o-sid');
    box.innerHTML = '';
    for (var i = 0; i !== 10; i++) {
      var d = document.createElement('div');
      d.textContent = id.charAt(i);
      box.appendChild(d);
    }
  }

  function fit() {
    var stage = $('aiou-stage');
    var s = Math.min(1, (stage.clientWidth - 16) / W);
    if (s <= 0) { s = 1; }
    $('aiou-paper').style.transform = 'scale(' + s + ')';
    $('aiou-holder').style.width = (W * s) + 'px';
    $('aiou-holder').style.height = (H * s) + 'px';
  }

  function snap() {
    var ready = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
    return ready.then(function () {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'position:fixed;left:0;top:0;z-index:-9999;pointer-events:none;background:#fff;width:' + W + 'px;height:' + H + 'px';
      var c = $('aiou-paper').cloneNode(true);
      c.removeAttribute('id');
      c.style.transform = 'none';
      wrap.appendChild(c);
      document.body.appendChild(wrap);
      return html2canvas(c, { scale: 3, useCORS: true, backgroundColor: '#ffffff', width: W, height: H, scrollX: 0, scrollY: 0 })
        .then(function (cv) { document.body.removeChild(wrap); return cv; },
              function (e) { document.body.removeChild(wrap); throw e; });
    });
  }

  function fname(ext) {
    var n = $('i-sname').value.trim().replace(/\s+/g, '_') || 'Student';
    var c = $('i-code').value.trim() || 'Form';
    return 'AIOU_' + n + '_' + c + '.' + ext;
  }
  function busy(on) { $('aiou-busy').style.display = on ? 'flex' : 'none'; }

  function exportImg(type) {
    busy(true);
    snap().then(function (cv) {
      var mime = type === 'png' ? 'image/png' : 'image/jpeg';
      cv.toBlob(function (blob) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = fname(type);
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        busy(false);
      }, mime, 0.95);
    }).catch(function (e) { busy(false); alert('Error: ' + e); });
  }

  function exportPdf() {
    busy(true);
    snap().then(function (cv) {
      var pdf = new window.jspdf.jsPDF('p', 'mm', 'a4');
      pdf.addImage(cv.toDataURL('image/jpeg', 0.95), 'JPEG', 0, 0, 210, 297);
      pdf.save(fname('pdf'));
      busy(false);
    }).catch(function (e) { busy(false); alert('Error: ' + e); });
  }

  function init() {
    var ids = ['i-tname','i-tphone','i-tadd','i-sname','i-sphone','i-sid','i-course','i-sadd','i-code','i-sem','i-year','i-due','i-disp'];
    for (var k = 0; k !== ids.length; k++) {
      $(ids[k]).addEventListener('input', update);
      $(ids[k]).addEventListener('change', update);
    }
    $('i-logo').addEventListener('change', function (e) {
      var f = e.target.files[0];
      if (!f) { return; }
      var r = new FileReader();
      r.onload = function (ev) { $('o-logo').src = ev.target.result; };
      r.readAsDataURL(f);
    });
    $('b-pdf').addEventListener('click', exportPdf);
    $('b-jpg').addEventListener('click', function () { exportImg('jpeg'); });
    $('b-png').addEventListener('click', function () { exportImg('png'); });
    window.addEventListener('resize', fit);
    update(); fit();
    setTimeout(fit, 400);
  }

  if (document.readyState === 'complete') { init(); } else { window.addEventListener('load', init); }
})();
//]]>
</script>
