rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isStaff() {
      return signedIn() &&
        (request.auth.token.admin == true || request.auth.token.teacher == true);
    }
    function hasActiveEnrollment(courseId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)) &&
        get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active';
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create, delete: if false;
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      }

      match /pushTokens/{tokenId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform == 'web';
        allow delete: if isSelf(uid);
      }

      match /private/{document=**} {
        allow read, write: if isSelf(uid);
      }
    }

    // Published catalog metadata can be discovered without exposing private keys.
    match /courses/{courseId} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    // Lessons and quiz metadata require an active enrollment in the owning course.
    match /lessons/{lessonId} {
      allow read: if isStaff() ||
        (resource.data.published == true && hasActiveEnrollment(resource.data.courseId));
      allow create, update, delete: if isStaff();
    }

    match /quizzes/{quizId} {
      allow read: if isStaff() ||
        (resource.data.published == true && hasActiveEnrollment(resource.data.courseId));
      allow create, update, delete: if isStaff();
    }

    // Enrollment status is staff-controlled; a student can only read their own.
    // Document ID contract: {uid}_{courseId}.
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid && enrollmentId == request.auth.uid + '_' + resource.data.courseId);
      allow create, update, delete: if isStaff();
    }

    // Attempts and progress are written only by trusted callable Functions.
    match /quizAttempts/{attemptId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /progress/{progressId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Correct answers and grading metadata are never directly readable by clients.
    match /quizAnswerKeys/{quizId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
